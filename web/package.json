{
  "name": "spindle-web",
  "private": true,
  "type": "module",
  "scripts": {
    "build:sdk": "esbuild sdk/src/index.js --bundle --format=esm --target=es2022 --minify --outfile=dist/repos.js",
    "build": "pnpm run build:css && pnpm run build:islands && pnpm run build:vendor && pnpm run build:sdk",
    "build:css": "vite build --config vite.app.config.mjs && rm -f dist/app-entry.js",
    "build:islands": "esbuild src/islands/index.js --bundle --format=esm --target=es2022 --outfile=dist/ui.js",
    "build:vendor": "cp vendor/htmx.min.js vendor/htmx-ext-sse.js dist/"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.3.3",
    "vite": "^8.2.2"
  }
}
