# build output
/spindle
/spindle-server
/bin/
*.test
*.out
.cover/

# web
web/dist/*
!web/dist/.keep
web/node_modules/
# exact path too: a trailing slash never matches a SYMLINK, and a worktree
# symlink committed by accident breaks pnpm in CI (ENOTDIR).
web/node_modules

# runtime data
/data/
*.json.tmp
walgit-state.json

# Forgejo #253: global gitignores blanket-ignore `tags` (ctags output) —
# re-include the package dir so internal/tags/* is tracked.
!internal/tags/

# agent workspace state (opencode goals/session scratch)
.opencode/

# local run scratch (servers, data dirs, pids, screenshots) — never commit it
.run/
